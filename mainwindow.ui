          <item>
           <widget class="QComboBox" name="comboBoxBuyTeam">
            <property name="currentText">
             <string/>
            </property>
           </widget>
          </item>
         </layout>
        </item>
        <item>
         <widget class="QListWidget" name="listWidgetTransferPlayers"/>
